<script>
function openEditWbsFromButton(button) {
    openEditWbs({
        id: button.dataset.id,
        code: button.dataset.code,
        title: button.dataset.title,
        target: button.dataset.target,
        notes: button.dataset.notes,
        parent_id: button.dataset.parentId,
        task_id: button.dataset.taskId,
        sort_order: button.dataset.sortOrder,
        url: button.dataset.url,
    });
}
function openEditWbs(item) {
    const modal = document.getElementById('editWbsModal');
    const form = document.getElementById('editWbsForm');
    form.action = item.url;
    document.getElementById('edit_code').value = item.code || '';
    document.getElementById('edit_title').value = item.title || '';
    document.getElementById('edit_target').value = item.target || '';
    document.getElementById('edit_notes').value = item.notes || '';
    document.getElementById('edit_sort_order').value = item.sort_order || 0;
    document.getElementById('edit_parent_id').value = item.parent_id || '';
    document.getElementById('edit_task_id').value = item.task_id || '';
    [...document.getElementById('edit_parent_id').options].forEach(option => {
        option.disabled = option.value && Number(option.value) === Number(item.id);
    });
    modal.classList.remove('hidden');
    modal.classList.add('flex');
}

function closeEditWbs() {
    const modal = document.getElementById('editWbsModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
}
</script>
@endif
<script>
function toggleAddWbs() {
    const form = document.getElementById('addWbsForm');
    const button = document.getElementById('toggleAddWbsButton');
    if (!form || !button) return;

    const isHidden = form.classList.contains('hidden');
    form.classList.toggle('hidden', !isHidden);
    button.textContent = isHidden ? 'Sembunyikan Form' : 'Buka Form';
}

function openWbsDetail(button) {
    const modal = document.getElementById('wbsDetailModal');
    document.getElementById('detail_code').textContent = button.dataset.code || '-';
    document.getElementById('detail_title').textContent = button.dataset.title || '-';
    document.getElementById('detail_target').textContent = button.dataset.target || '-';
    document.getElementById('detail_notes').textContent = button.dataset.notes || '-';
    document.getElementById('detail_card').textContent = button.dataset.card || '-';
    document.getElementById('detail_status').textContent = button.dataset.status || '-';
    document.getElementById('detail_priority').textContent = button.dataset.priority || '-';
    document.getElementById('detail_assignees').textContent = button.dataset.assignees || '-';
    document.getElementById('detail_start').textContent = button.dataset.start || '-';
    document.getElementById('detail_due').textContent = button.dataset.due || '-';

    const progress = Math.max(0, Math.min(100, Number(button.dataset.progress || 0)));
    document.getElementById('detail_progress_text').textContent = `${progress}%`;
    document.getElementById('detail_progress_bar').style.width = `${progress}%`;

    modal.classList.remove('hidden');
    modal.classList.add('flex');
}

function closeWbsDetail() {
    const modal = document.getElementById('wbsDetailModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
}
</script>
@endsection
